  "shortcuts": [
    {
      "name": "Schedule Consultation",
      "short_name": "Schedule",
      "description": "Book a consultation with our tax experts",
      "url": "/contact?action=schedule",
      "icons": [
        {
          "src": "/images/shortcut-calendar.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Tax Services",
      "short_name": "Tax Services",
      "description": "View our comprehensive tax preparation services",
      "url": "/services#tax-services",
      "icons": [
        {
          "src": "/images/shortcut-tax.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Contact Us",
      "short_name": "Contact",
      "description": "Get in touch with our accounting professionals",
      "url": "/contact",
      "icons": [
        {
          "src": "/images/shortcut-contact.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Tax Resources",
      "short_name": "Resources",
      "description": "Access tax forms, deadlines, and helpful guides",
      "url": "/resources",
      "icons": [
        {
          "src": "/images/shortcut-resources.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  
  "categories": [
    "business",
    "finance",
    "productivity",
    "lifestyle"
  ],
  
  "screenshots": [
    {
      "src": "/images/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Kelley Accounting homepage on desktop"
    },
    {
      "src": "/images/screenshot-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Kelley Accounting services on mobile"
    }
  ],
  
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "web",
      "url": "https://kelleyaccounting.com"
    }
  ],
  
  "iarc_rating_id": "",
  
  "edge_side_panel": {
    "preferred_width": 400
  },
  
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  
  "protocol_handlers": [
    {
      "protocol": "mailto",
      "url": "/contact?email=%s"
    },
    {
      "protocol": "tel",
      "url": "/contact?phone=%s"
    }
  ],
  
  "file_handlers": [
    {
      "action": "/upload",
      "accept": {
        "application/pdf": [".pdf"],
        "image/*": [".jpg", ".jpeg", ".png", ".gif"],
        "application/vnd.ms-excel": [".xls"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"],
        "text/csv": [".csv"]
      },
      "icons": [
        {
          "src": "/images/file-upload-icon.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  
  "share_target": {
    "action": "/contact",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "subject",
      "text": "message",
      "files": [
        {
          "name": "documents",
          "accept": ["application/pdf", "image/*", ".xlsx", ".csv"]
        }
      ]
    }
  }
}
